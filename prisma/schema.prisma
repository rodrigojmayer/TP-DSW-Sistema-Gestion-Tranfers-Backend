generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rol de Usuario
enum Rol {
  ADMIN
  CLIENTE
}

// Modelo Usuario
model Usuario {
  idUsuario String   @id @default(uuid())
  usuario   String   @unique
  password  String
  nombre    String
  apellido  String
  email     String   @unique
  telefono  String?
  rol       Rol      @default(CLIENTE)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo Ruta (Para el CRUD simple requerido)
model Ruta {
  idRuta    String   @id @default(uuid())
  nombre    String
  puntos    PuntoRuta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PuntoRuta {
  idPuntoRuta String @id @default(uuid())
  orden       Int
  idRuta      String
  ruta        Ruta   @relation(fields: [idRuta], references: [idRuta], onDelete: Cascade)
  idPunto     String
  punto       Punto  @relation(fields: [idPunto], references: [idPunto], onDelete: Restrict)

  @@unique([idRuta, idPunto])
}

model Punto {
  idPunto   String      @id @default(uuid())
  direccion String      @unique
  nombre    String?
  rutas     PuntoRuta[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}